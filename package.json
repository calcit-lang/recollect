{
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "test:calcit": "calcit calcit.cirru test --tag unit --require-match",
    "test:js": "calcit calcit.cirru --entry test js && node test.mjs",
    "test:wasm": "bash scripts/test-wasm.sh",
    "run:wasm:api": "bash scripts/run-wasm-api.sh",
    "build:js": "calcit calcit.cirru js && yarn vite build --base=./",
    "bench": "calcit calcit.cirru --init-fn recollect.bench/bench!",
    "test": "yarn test:calcit && yarn test:js"
  },
  "dependencies": {
    "@calcit/procs": "^0.13.44"
  },
  "devDependencies": {
    "bottom-tip": "^0.1.5",
    "vite": "^8.0.8"
  }
}
