{
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "test:cr": "cr test --tag unit --require-match",
    "test:js": "cr --entry test js && node test.mjs",
    "test:wasm": "bash scripts/test-wasm.sh",
    "run:wasm:api": "bash scripts/run-wasm-api.sh",
    "build:js": "cr js && yarn vite build --base=./",
    "bench:cr": "cr --init-fn recollect.bench/bench!",
    "test": "yarn test:cr && yarn test:js"
  },
  "dependencies": {
    "@calcit/procs": "^0.13.27"
  },
  "devDependencies": {
    "bottom-tip": "^0.1.5",
    "vite": "^8.0.8"
  }
}
